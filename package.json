    "motion": "^14.6.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "unpdf": "^1.9.1",
